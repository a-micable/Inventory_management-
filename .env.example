# --- Docker Compose (api/worker/beat containers use service names) ---
DATABASE_URL=postgresql+asyncpg://inventory:inventory@db:5432/inventory_db
SYNC_DATABASE_URL=postgresql://inventory:inventory@db:5432/inventory_db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Local dev outside Docker (map to published host ports) ---
# DATABASE_URL=postgresql+asyncpg://inventory:inventory@localhost:5433/inventory_db
# SYNC_DATABASE_URL=postgresql://inventory:inventory@localhost:5433/inventory_db
# REDIS_URL=redis://localhost:6380/0
# CELERY_BROKER_URL=redis://localhost:6380/1
# CELERY_RESULT_BACKEND=redis://localhost:6380/2

SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
RUN_MIGRATIONS=false
LOG_LEVEL=INFO
DEFAULT_TENANT_SLUG=demo
